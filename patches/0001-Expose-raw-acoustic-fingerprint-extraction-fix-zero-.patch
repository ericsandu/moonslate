+/* Extracts the underlying speaker embedding vector (d-vector) for the given audio.
+   ``diarization_model_dir`` must hold the downloaded diarization models
+   (``segmentation.ort`` and ``embedding.ort``, see
+   ``moonshine_get_diarization_dependencies``). On success, ``*out_embedding``
+   is set to a heap-allocated array of floats. Release the array with
+   ``moonshine_free_speaker_embedding``. */
+MOONSHINE_EXPORT int32_t moonshine_extract_speaker_embedding(
+    const float *audio_data, uint64_t audio_length, int32_t sample_rate,
+    const char *diarization_model_dir, float **out_embedding,
+    uint64_t *out_embedding_size);
+
+/* Frees a speaker embedding returned by moonshine_extract_speaker_embedding. */
+MOONSHINE_EXPORT void moonshine_free_speaker_embedding(float *embedding);
+
 /* Calculates the cosine similarity between two embedding vectors.
 
    Both ``embedding_a`` and ``embedding_b`` must have ``embedding_size``
