From 0f94972e005146f0717c36a85a0a477ae858ab27 Mon Sep 17 00:00:00 2001
From: Eric Sandu <eric_andrei.sandu@stud.acs.upb.ro>
Date: Sun, 16 Aug 2026 00:26:09 +0300
Subject: [PATCH 1/2] Expose raw acoustic fingerprint extraction & fix
 zero-padding InstanceNorm corruption

Rebased onto upstream main: the diarization models are no longer compiled
into the library, so moonshine_extract_speaker_embedding now takes a
diarization_model_dir holding segmentation.ort and embedding.ort.
---
 core/cpp-annote/src/cpp-annote.cpp | 49 ++++++++++++++++++++++++++++++
 core/cpp-annote/src/cpp-annote.h   |  4 +++
 core/moonshine-c-api.cpp           | 19 ++++++++++++
 core/moonshine-c-api.h             | 14 +++++++++
 4 files changed, 86 insertions(+)

diff --git a/core/cpp-annote/src/cpp-annote.cpp b/core/cpp-annote/src/cpp-annote.cpp
index 678c070..3b05afc 100644
--- a/core/cpp-annote/src/cpp-annote.cpp
+++ b/core/cpp-annote/src/cpp-annote.cpp
@@ -965,6 +965,49 @@ struct CppAnnote::Impl {
     }
     return r;
   }
+
+  std::vector<float> extract_embedding(const float *audio_data, uint64_t audio_length, int32_t sample_rate) {
+    std::vector<float> resampled;
+    int sr_model = engine.segmentation_model_sample_rate();
+    if (sample_rate != sr_model) {
+      std::vector<float> in(audio_data, audio_data + audio_length);
+      resampled = wav_pcm::linear_resample(in, sample_rate, sr_model);
+      audio_data = resampled.data();
+      audio_length = resampled.size();
+    }
+
+    int chunk_size = engine.segmentation_chunk_num_samples();
+    std::vector<float> chunk(chunk_size, 0.0f);
+    if (audio_length > 0) {
+        for(int i = 0; i < chunk_size; i++) {
+            chunk[i] = audio_data[i % audio_length];
+        }
+    }
+
+    std::vector<float> seg = engine.run_segmentation_ort_single(chunk.data());
+    std::vector<float> emb_all = engine.run_embedding_ort_single(chunk.data(), seg.data());
+
+    int K = engine.seg_classes();
+    int F = engine.seg_frames_per_chunk();
+    int dim = engine.embedding_dimension();
+
+    int best_sp = 0;
+    float max_activity = -1.0f;
+    for (int sp = 0; sp < K; ++sp) {
+        float activity = 0.0f;
+        for (int f = 0; f < F; ++f) {
+            activity += seg[f * K + sp];
+        }
+        if (activity > max_activity) {
+            max_activity = activity;
+            best_sp = sp;
+        }
+    }
+
+    std::vector<float> single_emb(dim);
+    std::copy(emb_all.begin() + best_sp * dim, emb_all.begin() + (best_sp + 1) * dim, single_emb.begin());
+    return single_emb;
+  }
 };
 
 CppAnnote::CppAnnote(const ModelSources& models)
@@ -1032,4 +1075,10 @@ DiarizationResults CppAnnote::diarize_stream(int32_t stream_id) {
   return Impl::to_results(snap);
 }
 
+std::vector<float> CppAnnote::extract_embedding(const float *audio_data,
+                                                uint64_t audio_length,
+                                                int32_t sample_rate) {
+  return impl_->extract_embedding(audio_data, audio_length, sample_rate);
+}
+
 }  // namespace cppannote
diff --git a/core/cpp-annote/src/cpp-annote.h b/core/cpp-annote/src/cpp-annote.h
index be26633..6cc6a06 100644
--- a/core/cpp-annote/src/cpp-annote.h
+++ b/core/cpp-annote/src/cpp-annote.h
@@ -77,6 +77,10 @@ class CppAnnote {
   DiarizationResults diarize(const float *audio_data, uint64_t audio_length,
                              int32_t sample_rate = 16000);
 
+  /// Extract speaker embedding (d-vector) from a mono PCM audio buffer.
+  std::vector<float> extract_embedding(const float *audio_data, uint64_t audio_length,
+                                       int32_t sample_rate = 16000);
+
   /// Allocate a new streaming diarization session and return its handle.
   /// ``cluster_cadence`` controls how often VBx re-clustering runs (seconds).
   /// ``analyze_cadence`` controls the step between segmentation+embedding model
diff --git a/core/moonshine-c-api.cpp b/core/moonshine-c-api.cpp
index 9461aa5..65742c5 100644
--- a/core/moonshine-c-api.cpp
+++ b/core/moonshine-c-api.cpp
@@ -68,6 +68,7 @@ SOFTWARE.
 #include "string-utils.h"
 #include "text-embedder.h"
 #include "transcriber.h"
+#include "cpp-annote/src/cpp-annote.h"
 
 // Defined as a macro to ensure we get meaningful line numbers in the error
 // message.
@@ -790,6 +791,24 @@ int32_t moonshine_calculate_embedding(int32_t embedding_model_handle,
 
 void moonshine_free_embedding(float *embedding) { std::free(embedding); }
 
+int32_t moonshine_extract_speaker_embedding(const float *audio_data, uint64_t audio_length, int32_t sample_rate, const char *diarization_model_dir, float **out_embedding, uint64_t *out_embedding_size) {
+    if (!audio_data || !out_embedding || !out_embedding_size || !diarization_model_dir) return MOONSHINE_ERROR_INVALID_ARGUMENT;
+    try {
+        std::filesystem::path dir(diarization_model_dir);
+        cppannote::CppAnnote engine((dir / "segmentation.ort").string(),
+                                    (dir / "embedding.ort").string());
+        std::vector<float> embed = engine.extract_embedding(audio_data, audio_length, sample_rate);
+        *out_embedding_size = embed.size();
+        *out_embedding = static_cast<float*>(std::malloc(embed.size() * sizeof(float)));
+        std::copy(embed.begin(), embed.end(), *out_embedding);
+        return MOONSHINE_ERROR_NONE;
+    } catch (...) {
+        return MOONSHINE_ERROR_UNKNOWN;
+    }
+}
+
+void moonshine_free_speaker_embedding(float *embedding) { std::free(embedding); }
+
 int32_t moonshine_calculate_embedding_distance(int32_t embedding_model_handle,
                                                const float *embedding_a,
                                                const float *embedding_b,
