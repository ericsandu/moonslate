From 6da0979e7eb8343026985f95a8b1e070dcfff608 Mon Sep 17 00:00:00 2001
From: Eric Sandu <eric_andrei.sandu@stud.acs.upb.ro>
Date: Sun, 16 Aug 2026 00:26:37 +0300
Subject: [PATCH 2/2] fix: Audio reversing cycle and static Annote
 instantiation

The cached CppAnnote engine now also rebuilds when the caller switches
diarization_model_dir.
---
 core/cpp-annote/src/cpp-annote.cpp |  8 +++++++-
 core/moonshine-c-api.cpp           | 18 ++++++++++++++----
 2 files changed, 21 insertions(+), 5 deletions(-)

diff --git a/core/cpp-annote/src/cpp-annote.cpp b/core/cpp-annote/src/cpp-annote.cpp
index 3b05afc..21bb8cc 100644
--- a/core/cpp-annote/src/cpp-annote.cpp
+++ b/core/cpp-annote/src/cpp-annote.cpp
@@ -980,7 +980,13 @@ struct CppAnnote::Impl {
     std::vector<float> chunk(chunk_size, 0.0f);
     if (audio_length > 0) {
         for(int i = 0; i < chunk_size; i++) {
-            chunk[i] = audio_data[i % audio_length];
+            int cycle = i / audio_length;
+            int idx = i % audio_length;
+            if (cycle % 2 == 1) {
+                chunk[i] = audio_data[audio_length - 1 - idx];
+            } else {
+                chunk[i] = audio_data[idx];
+            }
         }
     }
 
diff --git a/core/moonshine-c-api.cpp b/core/moonshine-c-api.cpp
index 65742c5..2bd3414 100644
--- a/core/moonshine-c-api.cpp
+++ b/core/moonshine-c-api.cpp
@@ -43,6 +43,7 @@ SOFTWARE.
 #include <cstring>  // For strerror
 #include <filesystem>
 #include <map>
+#include <memory>
 #include <mutex>
 #include <numeric>
 #include <optional>
@@ -794,10 +795,19 @@ void moonshine_free_embedding(float *embedding) { std::free(embedding); }
 int32_t moonshine_extract_speaker_embedding(const float *audio_data, uint64_t audio_length, int32_t sample_rate, const char *diarization_model_dir, float **out_embedding, uint64_t *out_embedding_size) {
     if (!audio_data || !out_embedding || !out_embedding_size || !diarization_model_dir) return MOONSHINE_ERROR_INVALID_ARGUMENT;
     try {
-        std::filesystem::path dir(diarization_model_dir);
-        cppannote::CppAnnote engine((dir / "segmentation.ort").string(),
-                                    (dir / "embedding.ort").string());
-        std::vector<float> embed = engine.extract_embedding(audio_data, audio_length, sample_rate);
+        static std::mutex g_annote_mutex;
+        static std::unique_ptr<cppannote::CppAnnote> g_annote;
+        static std::string g_annote_model_dir;
+
+        std::lock_guard<std::mutex> lock(g_annote_mutex);
+        if (!g_annote || g_annote_model_dir != diarization_model_dir) {
+            std::filesystem::path dir(diarization_model_dir);
+            g_annote = std::make_unique<cppannote::CppAnnote>((dir / "segmentation.ort").string(),
+                                                              (dir / "embedding.ort").string());
+            g_annote_model_dir = diarization_model_dir;
+        }
+
+        std::vector<float> embed = g_annote->extract_embedding(audio_data, audio_length, sample_rate);
         *out_embedding_size = embed.size();
         *out_embedding = static_cast<float*>(std::malloc(embed.size() * sizeof(float)));
         std::copy(embed.begin(), embed.end(), *out_embedding);
-- 
